# Public URL for the Backend API (Set to http://localhost:8000 for Laravel backend API)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Storage Configuration
# Set to 'true' in production to use cloud storage, leave false/empty for local dev
USE_CLOUD_STORAGE=

# Cloud Storage Credentials (e.g., S3, Cloudflare R2, or GCS)
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_ENDPOINT=

# Auth Cookie Name
COOKIE_NAME=

# OpenAPI API key
OPENAPI_API_KEY=
